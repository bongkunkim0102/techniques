---
import Base from '../../layouts/Base.astro';import Catalogue from '../../components/Catalogue.astro';import {categories,glossary} from '../../data/glossary.mjs';
export function getStaticPaths(){return categories.map(c=>({params:{slug:c.id},props:{c}}));}
const {c}=Astro.props;const count=glossary.filter(t=>t.bucket===c.id).length;
---
<Base title={c.name}><div class="crumbs"><a href="/">백과</a><span>/</span><span>분야별 탐색</span></div><h1>{c.name}</h1><p class="intro">{count}개 용어 정의. 학파·시대·적용 분야가 겹치는 항목은 관련 문서로 연결합니다.</p><Catalogue bucket={c.id} /></Base>
