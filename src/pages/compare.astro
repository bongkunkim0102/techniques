---
import Base from '../layouts/Base.astro';import {articles} from '../data/articles.mjs';
---
<Base title="기법 나란히 읽기"><h1>기법 나란히 읽기</h1><p class="intro">비슷해 보이는 기법의 정의와 적용 조건을 원문 출처와 함께 비교합니다.</p><div class="filters">{['left','right'].map((side,i)=><label>{i===0?'첫 번째 문서':'두 번째 문서'}<select id={side}>{articles.map(a=><option value={a.id} selected={a.id===(i===0?'translation-of-light':'collection-of-light')}>{a.title}</option>)}</select></label>)}</div><div class="compare-grid"><section id="left-panel" class="compare-panel"></section><section id="right-panel" class="compare-panel"></section></div><noscript><p>비교 선택에는 자바스크립트가 필요합니다. <a href="/wiki/translation-of-light/">빛의 전달</a>과 <a href="/wiki/collection-of-light/">빛의 수집</a> 문서를 열어 읽을 수 있습니다.</p></noscript><script type="application/json" id="compare-data" set:html={JSON.stringify(articles).replaceAll('<','\\u003c')}></script></Base>
<script>
  const data=JSON.parse(document.getElementById('compare-data')!.textContent!);const params=new URLSearchParams(location.search);
  for(const side of ['left','right']){const select=document.getElementById(side) as HTMLSelectElement;const chosen=params.get(side);if(data.some((a:any)=>a.id===chosen))select.value=chosen!;const render=()=>{const a=data.find((a:any)=>a.id===select.value);const panel=document.getElementById(`${side}-panel`)!;panel.replaceChildren();const h=document.createElement('h2');h.textContent=a.title;const p=document.createElement('p');p.textContent=a.summary;const meta=document.createElement('p');meta.className='meta';meta.textContent=a.tradition;panel.append(meta,h,p);for(const s of a.sections){const heading=document.createElement('h3');heading.textContent=s.title;panel.append(heading);for(const text of s.paragraphs){const para=document.createElement('p');para.textContent=text;panel.append(para);}}const link=document.createElement('a');link.href=`/wiki/${a.id}/#references`;link.textContent=`출처 ${a.refs.length}개와 전체 문서 보기`;panel.append(link);const q=new URLSearchParams(location.search);q.set(side,a.id);history.replaceState(null,'',`?${q}`);};select.addEventListener('change',render);render();}
</script>
